{
    "name": "group-mention",
    "version": "0.1.0-alpha",
    "description": "Allows for group mentions in Google Chat",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "format": "prettier \"**/*.+(js|ts|json)\"",
        "format:write": "prettier --write \"**/*.+(js|ts|json)\"",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "pretest": "npm run lint",
        "test": "jest",
        "prebuild": "npm run test",
        "build": "rollup --config",
        "predeploy": "npm run build",
        "deploy": "clasp push && clasp deploy"
    },
    "devDependencies": {
        "@babel/core": "^7.26.10",
        "@babel/plugin-transform-runtime": "^7.26.10",
        "@babel/preset-env": "^7.26.9",
        "@babel/preset-typescript": "^7.27.0",
        "@commitlint/cli": "^19.8.0",
        "@commitlint/config-conventional": "^19.8.0",
        "@commitlint/prompt-cli": "^19.8.0",
        "@eslint/js": "^9.25.1",
        "@google/clasp": "^2.5.0",
        "@jest/globals": "^29.7.0",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@types/google-apps-script": "^1.0.97",
        "eslint": "^9.25.1",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-jsdoc": "^50.6.9",
        "eslint-plugin-prettier": "^5.2.6",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "prettier": "3.5.3",
        "rollup": "^4.40.0",
        "rollup-plugin-copy": "^3.5.0",
        "ts-jest": "^29.3.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.31.0"
    },
    "author": "Jay Rost <j-frost@a3re.net>",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git@github.com:j-frost/group-mention.git",
        "directory": "."
    }
}
